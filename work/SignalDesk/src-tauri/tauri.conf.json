{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silicon Desk",
  "version": "1.1.0",
  "identifier": "local.signaldesk.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Silicon Desk — System Health",
        "width": 1310,
        "height": 850,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "upgradeCode": "95c1b0be-4708-50fd-9d17-e7f38dd1f865"
      }
    },
    "useLocalToolsDir": true,
    "resources": {
      "sensor-runtime/": "sensor-runtime/"
    }
  }
}
